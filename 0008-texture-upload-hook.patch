+void feed_image_now(const std::uint8_t *data, std::size_t bytes);
+
+// Lifeline: optional texture hook (ourcode/icons). When it is linked and enabled, a whole host->GS upload is
+// gathered first, handed to the hook (which may hash, dump or patch it in place), then fed as one block.
+// Off (the default) costs one branch per image packet.
+std::vector<std::uint8_t> g_upload;
+std::size_t g_upload_want = 0;
+std::uint32_t g_upload_psm = 0, g_upload_w = 0, g_upload_h = 0;
+
+bool upload_hook_on() {
+    static const bool on = lifeline_gs_upload_enabled && lifeline_gs_upload_wanted && lifeline_gs_upload && lifeline_gs_upload_enabled();
+    return on;
+}
+
+void upload_flush() {   // feed whatever was gathered (complete: through the hook; cut short: as it is)
+    if (g_upload.empty()) return;
+    std::vector<std::uint8_t> data;
+    data.swap(g_upload);
+    if (data.size() == g_upload_want) lifeline_gs_upload(g_upload_psm, g_upload_w, g_upload_h, data.data(), data.size());
+    g_upload_want = 0;
+    feed_image_now(data.data(), data.size());
+}
+
+void upload_begin(const State &s) {
+    upload_flush();
+    if (!upload_hook_on()) return;
+    g_upload_psm = static_cast<std::uint32_t>(s.bitbltbuf >> 56) & 0x3Fu;
+    g_upload_w = static_cast<std::uint32_t>(s.trxreg) & 0xFFFu;
+    g_upload_h = static_cast<std::uint32_t>(s.trxreg >> 32) & 0xFFFu;
+    if (!lifeline_gs_upload_wanted(g_upload_psm, g_upload_w, g_upload_h)) return;   // size/format filter: not gathered
+    g_upload_want = (static_cast<std::size_t>(g_upload_w) * g_upload_h * bits_per_pixel(g_upload_psm) + 7) / 8;
+}
+
 void feed_image(const std::uint8_t *data, std::size_t bytes) {
+    if (g_upload_want && (g_state.trxdir & 3u) == 0) {
+        const std::size_t take = std::min(bytes, g_upload_want - g_upload.size());
+        g_upload.insert(g_upload.end(), data, data + take);
+        if (g_upload.size() == g_upload_want) upload_flush();
+        if (take < bytes) feed_image_now(data + take, bytes - take);   // padding past the image: as upstream
+        return;
+    }
+    feed_image_now(data, bytes);
+}
+
+void feed_image_now(const std::uint8_t *data, std::size_t bytes) {
 #ifdef PS2_GPU
     if (gpu_on() && (g_state.trxdir & 3u) == 0) gpu::image_data(data, bytes);
 #endif
