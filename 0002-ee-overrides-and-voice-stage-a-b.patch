diff --git a/runtime/src/overrides.cpp b/runtime/src/overrides.cpp
new file mode 100644
index 0000000..f70898e
--- /dev/null
+++ b/runtime/src/overrides.cpp
@@ -0,0 +1,23 @@
+// Registry for per-game EE function overrides (see eerecomp --overrides).
+#include "ps2/generated.hpp"
+
+#include <unordered_map>
+
+namespace ps2 {
+
+namespace {
+std::unordered_map<std::uint32_t, OverrideFn> &table() {
+    static std::unordered_map<std::uint32_t, OverrideFn> t;
+    return t;
+}
+}
+
+void register_override(std::uint32_t pc, OverrideFn fn) { table()[pc] = fn; }
+
+bool ee_override(Cpu &c, std::uint32_t pc) {
+    auto &t = table();
+    const auto it = t.find(pc);
+    return it != t.end() && it->second(c, pc);
+}
+
+}
