@@ -0,0 +1,25 @@
+// Lifeline Recomp 0010: fast-forward speed cap (header-only so it can be unit-tested with a fake clock).
+#pragma once
+
+#include <cstdint>
+
+namespace ff_pacing {
+
+// One step per fast-forward frame. Times are performance-counter ticks (`frequency` per second); `period` is
+// one frame at the capped speed. Returns how many ms to sleep (rounded up, so a sleep never ends early). The
+// deadline advances by exactly one period per frame and the gap is signed, so cheap frames can't wrap it and
+// skip the wait; if we fall more than a period behind (slow frames), the deadline resyncs to now.
+struct Limiter {
+    std::uint64_t last = 0;
+    void reset() { last = 0; }
+    std::uint32_t step(std::uint64_t now, std::uint64_t period, std::uint64_t frequency) {
+        if (!last) last = now;
+        last += period;
+        const std::int64_t ahead = static_cast<std::int64_t>(last - now);
+        if (ahead > 0) return static_cast<std::uint32_t>((static_cast<std::uint64_t>(ahead) * 1000 + frequency - 1) / frequency);
+        if (-ahead > static_cast<std::int64_t>(period)) last = now;
+        return 0;
+    }
+};
+
+}  // namespace ff_pacing
