+// Fast-forward flag (Lifeline Recomp 0010): written by the host thread, read once per frame by pace().
+static std::atomic<bool> g_ff_active{false};
+bool ff_active() { return g_ff_active.load(std::memory_order_relaxed); }
+void set_ff_active(bool on) { g_ff_active.store(on, std::memory_order_relaxed); }
+int ff_max() {
+    static const int max = [] {
+        const char *e = std::getenv("PS2_FF_MAX");
+        const int v = e && *e ? std::atoi(e) : 4;
+        if (v >= 1 && v <= 16) return v;
+        std::fprintf(stderr, "[ff] PS2_FF_MAX=%s is not 1-16; using 4\n", e);
+        return 4;
+    }();
+    return max;
+}
