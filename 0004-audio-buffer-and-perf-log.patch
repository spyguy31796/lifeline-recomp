+// Lifeline Recomp 0004: audio pacing helpers (header-only so they can be unit-tested).
+#pragma once
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+namespace audio_pacing {
+
+// Whole-string decimal integer in [lo, hi] (values outside are clamped). Anything else (empty, "abc",
+// "1e3", "12ms", " 50", "+5", overflow) and, if `positive_only`, negatives fall back to `def` with a warning.
+// `pow2` additionally requires a power of two (used for the SDL buffer size).
+inline long env_int(const char *name, const char *text, long def, long lo, long hi, bool pow2 = false) {
+    if (!text) return def;
+    errno = 0;
+    char *end = nullptr;
+    const long v = std::strtol(text, &end, 10);
+    const bool ok = *text >= '0' && *text <= '9' && end && *end == '\0' && errno != ERANGE && v > 0;
+    if (!ok) {
+        std::fprintf(stderr, "[audio] %s=\"%s\" is not a positive integer; using %ld\n", name, text, def);
+        return def;
+    }
+    long c = std::clamp(v, lo, hi);
+    if (c != v) std::fprintf(stderr, "[audio] %s=%ld out of range %ld-%ld; using %ld\n", name, v, lo, hi, c);
+    if (pow2 && (c & (c - 1)) != 0) {
+        std::fprintf(stderr, "[audio] %s=%ld is not a power of two; using %ld\n", name, c, def);
+        return def;
+    }
+    return c;
+}
+
+// Per-frame starvation tracking. A frame counts as starved when less than one device buffer of
+// sound is queued after the queue has been fed once: SDL then pads with silence (a crackle) or is
+// about to. This also catches a queue that never fills up (stuck near zero at low fps).
+struct Stats {
+    std::uint64_t starved_frames = 0;   // frames with < one device buffer queued
+    std::uint64_t starve_events = 0;    // transitions into starvation (distinct dropouts)
+    bool fed = false, starving = false;
+
+    void frame(std::uint32_t queued_bytes, std::uint32_t device_buffer_bytes) {
+        if (!fed) {
+            if (queued_bytes == 0) return;      // nothing supplied yet (boot)
+            fed = true;
+        }
+        const bool low = queued_bytes < device_buffer_bytes;
+        if (low) ++starved_frames;
+        if (low && !starving) ++starve_events;
+        starving = low;
+    }
+};
+
+// A target shorter than two device buffers can never keep a full buffer queued after the device
+// pulls one, so every frame would look starved. Raise it to 2x the buffer (rounded up to whole ms).
+inline std::uint32_t effective_target_ms(std::uint32_t target_ms, std::uint32_t device_buffer_bytes, std::uint32_t bytes_per_ms) {
+    const std::uint32_t min_ms = (2u * device_buffer_bytes + bytes_per_ms - 1) / bytes_per_ms;
+    if (target_ms >= min_ms) return target_ms;
+    std::fprintf(stderr, "[audio] pacing target %u ms is below 2x the device buffer; using %u ms\n", target_ms, min_ms);
+    return min_ms;
+}
+
+// Drop incoming sound when the queue already holds the pacing target plus two device buffers,
+// so latency can't build up far beyond the target (e.g. 400 ms + ~43 ms, not ~820 ms).
+inline std::uint32_t cap_bytes(std::uint32_t target_ms, std::uint32_t device_buffer_bytes, std::uint32_t bytes_per_ms) {
+    return target_ms * bytes_per_ms + 2u * device_buffer_bytes;
+}
+
+}  // namespace audio_pacing
