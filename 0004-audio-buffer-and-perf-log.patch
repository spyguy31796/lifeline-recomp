 constexpr Uint32 kAudioBytesPerMs = 48 * 4;
 
+// Audio tuning (Lifeline Recomp 0004). PS2_AUDIO_BUFFER_MS: how much sound the pacer keeps queued
+// (default 120 ms, was a fixed 80 ms); a deeper queue rides out short emulation stalls instead of
+// crackling. PS2_AUDIO_SAMPLES: SDL device buffer in frames (default 1024, power of two).
+Uint32 audio_target_ms() {
+    static const Uint32 ms = [] {
+        const char *e = std::getenv("PS2_AUDIO_BUFFER_MS");
+        const long v = e ? std::strtol(e, nullptr, 10) : 120;
+        return static_cast<Uint32>(std::clamp<long>(v, 20, 400));
+    }();
+    return ms;
+}
+
+// PS2_PERF_LOG=1: once a second print fps, CPU/GPU busy, queued audio and audio underruns to stderr
+// (run.sh --debug saves stderr to logs/run-*.log). Underrun = the device queue ran dry since last check.
+std::atomic<std::uint64_t> g_underruns{0};
+bool g_audio_primed = false;
+void check_underrun() {
+    if (!g_audio) return;
+    const Uint32 q = SDL_GetQueuedAudioSize(g_audio);
+    if (q >= 20 * kAudioBytesPerMs) g_audio_primed = true;
+    else if (q == 0 && g_audio_primed) { ++g_underruns; g_audio_primed = false; }
+}
+
 void pace() {
     if (g_audio) {
         // The audio device clock paces emulation: wait while more than ~80 ms of sound is queued.
-        while (SDL_GetQueuedAudioSize(g_audio) > 80 * kAudioBytesPerMs) SDL_Delay(1);
+        check_underrun();
+        while (SDL_GetQueuedAudioSize(g_audio) > audio_target_ms() * kAudioBytesPerMs) SDL_Delay(1);
         return;
     }
     const std::uint64_t frequency = SDL_GetPerformanceFrequency();
