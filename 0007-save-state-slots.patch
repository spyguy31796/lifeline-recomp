 bool load_state(const std::uint8_t *data, std::size_t size);
+// Save or load a state while the game runs (any thread may call). It runs on the emulation thread right after
+// the next vblank, the same point --save-state uses: before() may veto it (returns false), after(result) always
+// runs on the emulation thread afterwards: Vetoed (before() refused, nothing was saved or loaded), Failed (the
+// save/load was attempted and failed) or Ok. Returns false (and does nothing) while an earlier request is pending.
+enum class StateResult { Ok, Failed, Vetoed };
+struct StateRequest {
+    bool load = false;
+    std::string path;
+    std::function<bool()> before;
+    std::function<void(StateResult)> after;
+};
+bool request_state(StateRequest request);
 bool halted();
 std::uint64_t frame_count();
 
