             g_state_request = false;
-            save_state(g_options.save_state_path);
+            if (g_frame_save) { g_frame_save = false; save_state(g_options.save_state_path); }
+            run_user_state();
         }
         c.pc &= ~kUnwind;
         run_due_events();
