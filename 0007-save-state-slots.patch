+bool request_state(StateRequest request) {
+    std::lock_guard<std::mutex> lock(g_user_state_mutex);
+    if (g_user_state) return false;
+    g_user_state = std::move(request);
+    g_user_state_pending.store(true, std::memory_order_release);
+    return true;
+}
+
+namespace {
+void run_user_state() {
+    std::optional<StateRequest> r;
+    {
+        std::lock_guard<std::mutex> lock(g_user_state_mutex);
+        r.swap(g_user_state);
+        g_user_state_pending.store(false, std::memory_order_release);
+    }
+    if (!r) return;
+    StateResult res = StateResult::Vetoed;
+    if (!r->before || r->before())
+        res = (r->load ? load_state(r->path) : save_state(r->path)) ? StateResult::Ok : StateResult::Failed;
+    if (r->after) r->after(res);
+}
+}
