 namespace ps2 {
 
+float display_aspect() {   // Lifeline Recomp 0009: read once, the window and GPU present use it every frame
+    static const float aspect = [] {
+        const char *ws = std::getenv("PS2_WIDESCREEN");
+        return ws && *ws == '1' ? 16.0f / 9.0f : 4.0f / 3.0f;
+    }();
+    return aspect;
+}
