+// Synthetic self-test (no game data): random VU1 programs through run_fast and run_faster from the same random
+// state; returns how many differ in registers, flags, VU1 memory or GS kicks. Used by tests/vu_fast_selftest.
+int selftest_fast(std::uint32_t seed, int programs, bool verbose) {
+    std::uint32_t x = seed ? seed : 1u;
+    const auto rnd = [&x] { x ^= x << 13; x ^= x >> 17; x ^= x << 5; return x; };
+    static const std::uint8_t kUpper[] = {0x00, 0x04, 0x08, 0x0C, 0x10, 0x14, 0x18, 0x1C, 0x1D, 0x1E, 0x1F, 0x20, 0x21, 0x22, 0x23, 0x24,
+                                          0x25, 0x26, 0x27, 0x28, 0x29, 0x2A, 0x2B, 0x2C, 0x2D, 0x2E, 0x2F};
+    static const std::uint16_t kUpperSpecial[] = {0x00, 0x04, 0x08, 0x0C, 0x10, 0x14, 0x18, 0x1C, 0x1D, 0x1E, 0x1F, 0x20, 0x21, 0x22,
+                                                  0x23, 0x24, 0x25, 0x26, 0x27, 0x28, 0x29, 0x2A, 0x2C, 0x2D, 0x2E, 0x2F, 0x2B};
+    // lower ops: fast-handled ones plus slow ones (div/sqrt/rsqrt, waitq, flag ops, mfp, rand, efu, xgkick, fcset...)
+    static const std::uint8_t kLowerSpecial[] = {0x30, 0x31, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x3A, 0x3B, 0x3C, 0x3D, 0x3E, 0x3F,
+                                                 0x40, 0x41, 0x42, 0x43, 0x64, 0x68, 0x69, 0x6C, 0x70, 0x72, 0x76, 0x78, 0x7B, 0x7C, 0x7E};
+    static const std::uint8_t kLowerFunct[] = {0x30, 0x31, 0x32, 0x34, 0x35};
+    static const std::uint8_t kLowerOp[] = {0x00, 0x01, 0x04, 0x05, 0x08, 0x09, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
+                                            0x18, 0x1A, 0x1B, 0x1C, 0x20, 0x21, 0x28, 0x29, 0x2C, 0x2D, 0x2E, 0x2F};
+    int bad = 0;
+    std::vector<std::uint8_t> mem0(16384);
+    for (int p = 0; p < programs; ++p) {
+        const std::uint32_t entry = (rnd() % 64u) * 8u, len = 4u + rnd() % 60u;
+        std::memset(g_vu1_code, 0, 16384);
+        for (std::uint32_t k = 0; k < len; ++k) {
+            const std::uint32_t pc = entry + k * 8u;
+            std::uint32_t hi = rnd() & 0x01FFFFC0u, lo;   // random dest/ft/fs/fd
+            if (rnd() % 4u == 0) hi |= 0x3Cu | (kUpperSpecial[rnd() % sizeof kUpperSpecial] & 3u) | ((kUpperSpecial[rnd() % sizeof kUpperSpecial] >> 2) << 6);
+            else hi |= kUpper[rnd() % sizeof kUpper] | (rnd() & 3u);
+            const unsigned pick = rnd() % 8u;
+            if (pick == 0) { hi |= 0x80000000u; lo = rnd(); }                                         // I bit: lo is the I value
+            else if (pick <= 3) { const std::uint8_t s = kLowerSpecial[rnd() % sizeof kLowerSpecial];
+                                  lo = (0x40u << 25) | (rnd() & 0x01FFF800u) | ((s >> 2u) << 6) | 0x3Cu | (s & 3u); }
+            else if (pick == 4) lo = (0x40u << 25) | (rnd() & 0x01FFFFC0u) | kLowerFunct[rnd() % sizeof kLowerFunct];
+            else {
+                const std::uint8_t op = kLowerOp[rnd() % sizeof kLowerOp];
+                lo = (static_cast<std::uint32_t>(op) << 25) | (rnd() & 0x01FFF800u);
+                if (op >= 0x20) {   // forward branches only, landing at or before the E-bit op so every program ends
+                    if (k + 3u < len) lo |= (1u + rnd() % (len - 3u - k)) & 0x7FFu;
+                    else lo = 0x8000033Cu;
+                }
+                else lo |= rnd() & 0x7FFu;
+            }
+            if (k + 2u == len) hi |= 0x40000000u;                                                     // E bit, then one delay slot
+            if (k + 1u >= len - 1u && (lo >> 25) >= 0x20u && (lo >> 25) <= 0x2Fu && !(hi & 0x80000000u)) lo = 0x8000033Cu;
+            std::memcpy(g_vu1_code + pc, &lo, 4);
+            std::memcpy(g_vu1_code + pc + 4, &hi, 4);
+        }
+        code_changed(1);
+        Vu0Regs start{};
+        auto *raw = reinterpret_cast<std::uint32_t *>(&start);
+        for (std::size_t i = 0; i < offsetof(Vu0Regs, tpc) / 4; ++i) raw[i] = rnd() % 5u == 0 ? 0x3F800000u : rnd();
+        start.vf[0].d[0] = 0; start.vf[0].w[2] = 0; start.vf[0].w[3] = fp::kOne; start.vi[0] = 0;
+        for (auto &b : mem0) b = static_cast<std::uint8_t>(rnd());
+        VuSnap a, b;
+        std::vector<std::vector<std::uint8_t>> *const saved = g_kick_sink;
+        g_vu1 = start; std::memcpy(g_vu1_mem, mem0.data(), 16384); g_kick_sink = &a.kicks;
+        run_fast(1, entry);
+        a.regs = g_vu1; a.mem.assign(g_vu1_mem, g_vu1_mem + 16384);
+        g_vu1 = start; std::memcpy(g_vu1_mem, mem0.data(), 16384); g_kick_sink = &b.kicks;
+        run_faster(1, entry);
+        b.regs = g_vu1; b.mem.assign(g_vu1_mem, g_vu1_mem + 16384);
+        g_kick_sink = saved;
+        int index;
+        if (const char *what = first_diff(b, a, index)) {
+            if (verbose && bad < 10) std::fprintf(stderr, "[vu-selftest] program %d (entry 0x%04X, %u ops): %s %d\n", p, entry, len, what, index);
+            ++bad;
+        }
+    }
+    return bad;
+}
