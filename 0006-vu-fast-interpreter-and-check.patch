+// Lifeline: PS2_VU_SELFTEST=<programs> makes ps2run run the [qol] vu_fast self-test (random VU1 programs, no game
+// data, original vs faster interpreter) before anything else and exit: 0 if every result matched, 1 otherwise.
+namespace {
+const int g_vu_selftest = [] {
+    const char *v = std::getenv("PS2_VU_SELFTEST");
+    if (!v || !*v) return 0;
+    const int programs = std::atoi(v) > 0 ? std::atoi(v) : 20000;
+    const int bad = ps2::vu::selftest_fast(12345u, programs, true);
+    std::printf("vu_fast selftest: %d programs, %d mismatches (seed 12345)\n", programs, bad);
+    std::fflush(stdout);
+    std::_Exit(bad == 0 ? 0 : 1);
+}();
